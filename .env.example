# ═══════════════════════════════════════════════════════════════
# AirCrypto MZ — Environment Variables
# Copy to .env and fill with real values. NEVER commit .env
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# Database path (V1 uses atomic JSON store; .db is rewritten to .json)
DATABASE_URL=./data/aircrypto.db

# ─── NOWPayments ─────────────────────────────────────────────
# https://nowpayments.io
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# Public base URL for IPN callbacks (must be reachable by NOWPayments)
PUBLIC_BASE_URL=http://localhost:3000

# ─── Reloadly ────────────────────────────────────────────────
# https://app.reloadly.com
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

# ─── Pricing (defaults; can be overridden per-product later) ─
# Margin in MZN absolute or use PCT. Absolute preferred for control.
DEFAULT_MARGIN_MZN=5
DEFAULT_PAYMENT_BUFFER_MZN=1
# Optional percentage margin (0.05 = 5%). Absolute takes precedence if set.
DEFAULT_MARGIN_PCT=0

# ─── Admin (simple shared secret for V1) ─────────────────────
ADMIN_TOKEN=change-me-to-a-long-random-string

# ─── Enabled crypto (comma-separated, BCH must be first) ─────
ENABLED_CRYPTOS=BCH,USDT,BTC,LTC,ETH

# ─── Development / simulation ────────────────────────────────
# When true, allows simulated payment confirmation (NEVER in production)
ALLOW_SIMULATION=true
